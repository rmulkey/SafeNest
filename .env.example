# Database
DATABASE_URL="postgresql://user:password@localhost:5432/safenest?schema=public"

# Sanity CMS
NEXT_PUBLIC_SANITY_PROJECT_ID=""
NEXT_PUBLIC_SANITY_DATASET="production"
SANITY_API_TOKEN=""
SANITY_WEBHOOK_SECRET=""

# Klaviyo Email (OPTIONAL — not currently used).
# The newsletter stores subscribers in the app's own PostgreSQL database
# (first-party list). If you later integrate an email service provider, wire it
# into the /api/newsletter/subscribe route and set its key here.
KLAVIYO_API_KEY=""

# Analytics - Google Analytics 4
NEXT_PUBLIC_GA4_MEASUREMENT_ID=""

# Analytics - PostHog
NEXT_PUBLIC_POSTHOG_KEY=""

# Analytics - Meta Pixel
NEXT_PUBLIC_META_PIXEL_ID=""

# Affiliate
AMAZON_AFFILIATE_TAG=""

# Cron job authorization
CRON_SECRET=""

# Admin notifications (webhook URL for alerts, e.g. Slack incoming webhook)
ADMIN_WEBHOOK_URL=""

# Site URL (used for OG/Twitter meta tags, canonical URLs, sitemap)
NEXT_PUBLIC_SITE_URL="https://safenesttoys.com"

# Google Search Console verification token (optional).
# From Search Console > add property > "HTML tag" method, copy the value of
# the content attribute (the token only, not the whole tag), then redeploy.
GOOGLE_SITE_VERIFICATION=""

# IndexNow key (optional — a working default ships in src/lib/seo/indexnow.ts).
# NOT a secret: it is published at /indexnow-key.txt so participating engines can
# confirm domain ownership. Set this only to rotate the key. 8-128 chars of
# a-z, A-Z, 0-9 or '-'.
# Reaches Bing, Yandex and the other engines at indexnow.org — NOT Google.
INDEXNOW_KEY=""

# ─── Amazon Creators API ─────────────────────────────────────────────────────
# Replaces the Product Advertising API (PA-API). Amazon is explicit that old
# PA-API credentials (AWS access key / secret key) do NOT work here — Creators
# API needs its own credentials, generated in Amazon Associates Central under
# Tools > Creators API.
#
# Auth is OAuth2 client_credentials against the Login with Amazon token
# endpoint, exchanged for a bearer token with scope "creatorsapi::default".
# Tokens expire in 3600s and should be cached and reused, not re-fetched per call.
#
# SECURITY: server-side only. Never prefix these with NEXT_PUBLIC_ — that would
# ship the secret to the browser, which Amazon's own guidance prohibits.

# From the Credential ID column in Associates Central. Looks like
# amzn1.application-oa2-client.<32 hex chars>. Use the copy button rather than
# retyping it.
AMAZON_CREATORS_CLIENT_ID=""

# Shown ONCE when the credential is created. If it was not saved, delete the
# credential and generate a new one — it cannot be retrieved later.
AMAZON_CREATORS_CLIENT_SECRET=""

# Credential version from Associates Central. This selects the token endpoint:
#   3.1 -> North America  https://api.amazon.com/auth/o2/token     (US, CA, MX, BR)
#   3.2 -> Europe         https://api.amazon.co.uk/auth/o2/token   (UK, DE, FR, IT, ES, …)
#   3.3 -> Far East       https://api.amazon.co.jp/auth/o2/token   (JP, SG, AU)
# Credentials work globally; this only picks where the token is minted.
AMAZON_CREATORS_CREDENTIAL_VERSION="3.1"

# Application id shown beside the application name in Associates Central.
AMAZON_CREATORS_APPLICATION_ID=""

# Partner tag sent as `partnerTag` in every request, and the marketplace whose
# catalog is queried (sent as the x-marketplace header and `marketplace` param).
# The partner tag must be valid for the marketplace you target.
AMAZON_CREATORS_PARTNER_TAG=""
AMAZON_CREATORS_MARKETPLACE="www.amazon.com"

# Catalog access is gated on Associates sales volume, separately from the
# credential. Amazon's Creators API docs require at least 10 qualifying sales in
# the past 30 days, and access lapses after 30 consecutive days with no qualified
# referring sales. A valid credential that mints tokens can still return
# HTTP 403 AssociateNotEligible on every catalog call.
#
# Check which of the two is failing:
#   set -a; . ./.env.local; set +a
#   node scripts/check-amazon-creators.mjs

# ── Semrush ─────────────────────────────────────────────────────────────────────
# Read-only reporting credentials. Nothing in the app reads these; they are used
# by scripts/pull-semrush.mjs to fetch Site Audit and Organic Research data so a
# hosted crawler's findings can be reconciled against scripts/audit-onpage.mjs.
#
# Both the Analytics API (api.semrush.com) and the Projects API — which is where
# Site Audit lives — require the SEO Business plan with available API units. The
# key is on the Subscription Info page.
SEMRUSH_API_KEY=""
# Project ID, the numeric segment of the workspace URL:
# https://www.semrush.com/seo/{SEMRUSH_PROJECT_ID}/
SEMRUSH_PROJECT_ID=""
