{
  "framework": "nextjs",
  "buildCommand": "npm run build",
  "installCommand": "npm ci",
  "crons": [
    {
      "path": "/api/cron/check-links",
      "schedule": "0 6 * * *"
    },
    {
      "path": "/api/cron/publish-products",
      "schedule": "30 6 * * *"
    },
    {
      "path": "/api/cron/generate-blog-post",
      "schedule": "0 7 * * *"
    },
    {
      "path": "/api/cron/audit-affiliate-links",
      "schedule": "0 8 * * 1"
    },
    {
      "path": "/api/cron/sync-recalls",
      "schedule": "0 5 * * *"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        }
      ]
    }
  ]
}
