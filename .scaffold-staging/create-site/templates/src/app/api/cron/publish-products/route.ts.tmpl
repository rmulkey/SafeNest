import { NextRequest } from "next/server";
import { revalidatePath } from "next/cache";
import { publishQueuedBatch } from "@core";
import siteConfig from "@/site.config";
import { createSanityCatalogStore } from "@/lib/sanity/catalog-store";
import { reviewFieldOptions } from "@/lib/sanity/review-fields";

/**
 * GET /api/cron/publish-products
 *
 * Daily cron: publishes up to N verified products from the Sanity
 * `queuedProduct` queue into the live catalog via `@core`'s `publishQueuedBatch`
 * — which re-verifies the affiliate URL, the image bytes, and every required
 * field before publishing (data-integrity gate). The CMS I/O is the app's
 * Sanity `CatalogStore`. Protected by `CRON_SECRET`; requires a write token.
 */
export const maxDuration = 60;

const DAILY_LIMIT = 5;

export async function GET(request: NextRequest) {
  const authHeader = request.headers.get("authorization");
  const cronSecret = process.env.CRON_SECRET;
  if (!cronSecret || authHeader !== `Bearer ${cronSecret}`) {
    return Response.json({ error: "Unauthorized" }, { status: 401 });
  }
  if (!process.env.SANITY_API_TOKEN) {
    return Response.json({ error: "SANITY_API_TOKEN not configured" }, { status: 500 });
  }

  try {
    const outcomes = await publishQueuedBatch(
      {
        config: siteConfig,
        store: createSanityCatalogStore(),
        reviewFieldOptions,
      },
      DAILY_LIMIT,
    );

    const published = outcomes.filter((o) => o.status === "published");
    const failed = outcomes.filter((o) => o.status === "failed");
    const deferred = outcomes.filter((o) => o.status === "deferred");
    const duplicates = outcomes.filter((o) => o.status === "skipped-duplicate");

    if (published.length > 0) {
      for (const path of ["/", "/reviews", "/best-__PRODUCT_NOUN_PLURAL__", "/gift-guides"]) {
        try {
          revalidatePath(path);
        } catch {
          // best-effort
        }
      }
    }

    console.log(
      `[cron/publish-products] published=${published.length} failed=${failed.length} deferred=${deferred.length} duplicate=${duplicates.length}`,
    );

    return Response.json({
      ok: true,
      attempted: outcomes.length,
      published: published.length,
      failed: failed.length,
      deferred: deferred.length,
      duplicates: duplicates.length,
      outcomes,
    });
  } catch (error) {
    console.error("[cron/publish-products] error:", error);
    return Response.json(
      { error: error instanceof Error ? error.message : "Unknown error" },
      { status: 500 },
    );
  }
}
