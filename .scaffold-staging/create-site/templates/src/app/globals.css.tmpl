@import "tailwindcss";
@import "tw-animate-css";

/*
 * __SITE_NAME__ theme tokens (scaffold).
 *
 * These token values are PLACEHOLDERS. The @ui components reference token-based
 * classes (`bg-background`, `text-primary-600`, `bg-primary`, `bg-score-*`),
 * so keep this token set in shape; recolor it to match `site.config.ts`'s
 * `theme.palette` when you brand the site.
 */

@custom-variant dark (&:is(.dark *));

@theme inline {
  /* Primary */
  --color-primary-50: hsl(215 28% 97%);
  --color-primary-100: hsl(215 28% 93%);
  --color-primary-200: hsl(215 28% 85%);
  --color-primary-300: hsl(215 28% 72%);
  --color-primary-400: hsl(215 28% 55%);
  --color-primary-500: hsl(215 28% 42%);
  --color-primary-600: hsl(215 28% 34%);
  --color-primary-700: hsl(215 28% 28%);
  --color-primary-800: hsl(215 28% 22%);
  --color-primary-900: hsl(215 28% 16%);
  --color-primary-950: hsl(215 28% 9%);

  /* Secondary */
  --color-secondary-50: hsl(160 22% 96%);
  --color-secondary-100: hsl(160 22% 91%);
  --color-secondary-200: hsl(160 22% 82%);
  --color-secondary-300: hsl(160 22% 68%);
  --color-secondary-400: hsl(160 22% 54%);
  --color-secondary-500: hsl(160 22% 42%);
  --color-secondary-600: hsl(160 22% 34%);
  --color-secondary-700: hsl(160 22% 27%);
  --color-secondary-800: hsl(160 22% 21%);
  --color-secondary-900: hsl(160 22% 15%);
  --color-secondary-950: hsl(160 22% 8%);

  /* Accent */
  --color-accent-50: hsl(30 30% 96%);
  --color-accent-100: hsl(30 30% 92%);
  --color-accent-200: hsl(30 30% 84%);
  --color-accent-300: hsl(30 30% 71%);
  --color-accent-400: hsl(30 30% 57%);
  --color-accent-500: hsl(30 30% 45%);
  --color-accent-600: hsl(30 30% 37%);
  --color-accent-700: hsl(30 30% 30%);
  --color-accent-800: hsl(30 30% 24%);
  --color-accent-900: hsl(30 30% 18%);
  --color-accent-950: hsl(30 30% 10%);

  /* Neutral */
  --color-neutral-50: hsl(0 0% 98%);
  --color-neutral-100: hsl(0 0% 95%);
  --color-neutral-200: hsl(0 0% 90%);
  --color-neutral-300: hsl(0 0% 80%);
  --color-neutral-400: hsl(0 0% 65%);
  --color-neutral-500: hsl(0 0% 50%);
  --color-neutral-600: hsl(0 0% 40%);
  --color-neutral-700: hsl(0 0% 30%);
  --color-neutral-800: hsl(0 0% 20%);
  --color-neutral-900: hsl(0 0% 12%);
  --color-neutral-950: hsl(0 0% 6%);

  /* Score-quality tokens (niche-agnostic high/medium/low). Consumed by @ui via
   * `bg-score-*` / `text-score-*` (ScoreBadge, AxisScoreDisplay, ReviewCard). */
  --color-score-high: hsl(160 22% 40%);
  --color-score-medium: hsl(40 25% 50%);
  --color-score-low: hsl(0 25% 50%);

  /* Semantic scalar tokens */
  --color-background: hsl(0 0% 100%);
  --color-foreground: hsl(215 28% 12%);
  --color-muted: hsl(215 16% 96%);
  --color-muted-foreground: hsl(215 16% 45%);
  --color-border: hsl(215 16% 90%);
  --color-input: hsl(215 16% 90%);
  --color-ring: hsl(215 28% 45%);
  --color-card: hsl(0 0% 100%);
  --color-card-foreground: hsl(215 28% 12%);
  --color-popover: hsl(0 0% 100%);
  --color-popover-foreground: hsl(215 28% 12%);
  --color-primary: hsl(215 28% 34%);
  --color-primary-foreground: hsl(0 0% 100%);
  --color-secondary: hsl(160 22% 40%);
  --color-secondary-foreground: hsl(0 0% 100%);
  --color-accent: hsl(30 30% 45%);
  --color-accent-foreground: hsl(0 0% 100%);
  --color-destructive: hsl(0 60% 45%);

  /* Typography */
  --font-sans: var(--font-geist-sans), system-ui, -apple-system, sans-serif;
  --font-mono: var(--font-geist-mono), ui-monospace, monospace;
  --font-heading: var(--font-sans);

  /* Breakpoints */
  --breakpoint-sm: 640px;
  --breakpoint-md: 768px;
  --breakpoint-lg: 1024px;
  --breakpoint-xl: 1280px;

  --radius-sm: 0.375rem;
  --radius-md: 0.5rem;
  --radius-lg: 0.625rem;
  --radius-xl: 0.875rem;
}

html {
  scroll-behavior: smooth;
}

/*
 * Per-axis accent (Req 7.3 themeable axis presentation). The @ui
 * `AxisScoreDisplay` root carries `data-axis="{axis.key}"` and reads
 * `--axis-accent` (with a `--color-primary` fallback). Map each configured axis
 * key to a token so axes read distinctly. Update these selectors if you rename
 * the axis keys in `site.config.ts`.
 */
[data-axis="quality"] {
  --axis-accent: var(--color-secondary-600);
}
[data-axis="value"] {
  --axis-accent: var(--color-primary-600);
}

body {
  background: var(--color-background);
  color: var(--color-foreground);
  font-family: var(--font-sans);
  font-size: 1rem;
  line-height: 1.6;
}

/* Focus styles for accessibility (WCAG AA) */
:focus-visible {
  outline: 2px solid var(--color-primary-600);
  outline-offset: 2px;
  border-radius: 4px;
}

@media (prefers-reduced-motion: reduce) {
  html {
    scroll-behavior: auto;
  }
  *,
  *::before,
  *::after {
    animation-duration: 0.01ms !important;
    animation-iteration-count: 1 !important;
    transition-duration: 0.01ms !important;
    scroll-behavior: auto !important;
  }
}

@layer base {
  body {
    @apply bg-background text-foreground;
  }
}
