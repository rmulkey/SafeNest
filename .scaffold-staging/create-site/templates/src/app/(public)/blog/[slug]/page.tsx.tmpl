import type { Metadata } from "next";
import { notFound } from "next/navigation";
import { NewsletterForm } from "@ui";
import siteConfig from "@/site.config";
import { sanityClient } from "@/lib/sanity/client";
import { blogPostBySlugQuery } from "@/lib/sanity/queries";

interface BlogPost {
  _id: string;
  title: string;
  slug: { current: string };
  publishedAt?: string;
  excerpt?: string;
}

async function getPost(slug: string): Promise<BlogPost | null> {
  try {
    return await sanityClient.fetch<BlogPost | null>(blogPostBySlugQuery, { slug });
  } catch {
    return null;
  }
}

export async function generateMetadata({
  params,
}: {
  params: Promise<{ slug: string }>;
}): Promise<Metadata> {
  const { slug } = await params;
  const post = await getPost(slug);
  if (!post) return { title: "Post not found" };
  return {
    title: `${post.title} | ${siteConfig.brand.name}`,
    description: post.excerpt ?? post.title,
  };
}

/**
 * Blog post (thin shell). Renders the post header + excerpt and the newsletter
 * CTA. Rich portable-text body rendering is left as a follow-up (it would add a
 * portable-text renderer dependency); the shell type-checks and renders.
 *
 * Rendered dynamically (no `generateStaticParams`): post slugs come from the
 * CMS, so under Cache Components this resolves per request.
 */
export default async function BlogPostPage({
  params,
}: {
  params: Promise<{ slug: string }>;
}) {
  const { slug } = await params;
  const post = await getPost(slug);
  if (!post) notFound();

  return (
    <main className="mx-auto max-w-3xl px-4 py-12">
      <article>
        <h1 className="text-3xl font-bold tracking-tight text-foreground md:text-4xl">
          {post.title}
        </h1>
        {post.publishedAt && (
          <p className="mt-2 text-sm text-muted-foreground">
            {new Date(post.publishedAt).toLocaleDateString()}
          </p>
        )}
        {post.excerpt && (
          <p className="mt-6 text-lg text-muted-foreground">{post.excerpt}</p>
        )}
      </article>

      <div className="mt-12">
        <NewsletterForm variant="inline" />
      </div>
    </main>
  );
}
