import type { Metadata } from "next";
import { notFound } from "next/navigation";
import { ReviewCard } from "@ui";
import siteConfig from "@/site.config";
import { sanityClient } from "@/lib/sanity/client";
import { categoryBySlugQuery } from "@/lib/sanity/queries";
import { getReviewSummariesByCategorySlug } from "@/lib/sanity/review-views";

interface Category {
  _id: string;
  title: string;
  slug: { current: string };
  description?: string;
}

async function getCategory(slug: string): Promise<Category | null> {
  try {
    return await sanityClient.fetch<Category | null>(categoryBySlugQuery, { slug });
  } catch {
    return null;
  }
}

export async function generateStaticParams(): Promise<Array<{ slug: string }>> {
  return siteConfig.taxonomy.map((t) => ({ slug: t.slug }));
}

export async function generateMetadata({
  params,
}: {
  params: Promise<{ slug: string }>;
}): Promise<Metadata> {
  const { slug } = await params;
  const category = await getCategory(slug);
  if (!category) return { title: "Category not found" };
  return {
    title: `${category.title} | ${siteConfig.brand.name}`,
    description:
      category.description ??
      `Our independently scored ${category.title.toLowerCase()} reviews.`,
  };
}

/** Category page (thin shell): reviews in the category as `@ui` `ReviewCard`s. */
export default async function CategoryPage({
  params,
}: {
  params: Promise<{ slug: string }>;
}) {
  const { slug } = await params;
  const category = await getCategory(slug);
  if (!category) notFound();

  const reviews = await getReviewSummariesByCategorySlug(slug);

  return (
    <main className="mx-auto max-w-6xl px-4 py-10">
      <h1 className="text-3xl font-bold tracking-tight text-foreground">
        {category.title}
      </h1>
      {category.description && (
        <p className="mt-3 max-w-2xl text-muted-foreground">{category.description}</p>
      )}

      {reviews.length === 0 ? (
        <p className="mt-8 text-muted-foreground">
          No reviews in this category yet.
        </p>
      ) : (
        <ul className="mt-8 grid grid-cols-1 gap-6 sm:grid-cols-2 lg:grid-cols-3">
          {reviews.map((r) => (
            <li key={r._id}>
              <ReviewCard
                productName={r.productName}
                slug={r.slug}
                scores={r.scores}
                segment={r.segment}
                category={r.category}
                hasActiveRecall={r.hasActiveRecall}
              />
            </li>
          ))}
        </ul>
      )}
    </main>
  );
}
