import {
  createGiftGuideOgImage,
  getGiftGuideBySlug,
  createDefaultOgImage,
  OG_IMAGE_SIZE,
  OG_IMAGE_CONTENT_TYPE,
} from "@core/seo";
import siteConfig from "@/site.config";
import { renderOgImage } from "@/lib/og/render-og";

/** Per-guide OG card for gift-guide detail pages. */
export const size = OG_IMAGE_SIZE;
export const contentType = OG_IMAGE_CONTENT_TYPE;
export const alt = `${siteConfig.brand.name} gift guide`;

export default async function Image({
  params,
}: {
  params: Promise<{ slug: string }>;
}) {
  const { slug } = await params;
  const guide = getGiftGuideBySlug(siteConfig, slug);
  if (!guide) {
    return renderOgImage(createDefaultOgImage(siteConfig));
  }
  return renderOgImage(
    createGiftGuideOgImage(siteConfig, { title: guide.title, emoji: guide.emoji }),
  );
}
