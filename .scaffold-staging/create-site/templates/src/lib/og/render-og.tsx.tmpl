import { ImageResponse } from "next/og";
import type { OgImageDescriptor } from "@core";

/**
 * Render an engine `OgImageDescriptor` into a Next `ImageResponse`. The engine
 * computes the descriptor (colors/brand/headline from `SiteConfig`); this thin
 * app-side renderer turns it into the actual card, so no brand literals live in
 * the `opengraph-image` route files.
 */
export function renderOgImage(d: OgImageDescriptor): ImageResponse {
  const { colors, brand } = d;

  return new ImageResponse(
    (
      <div
        style={{
          width: "100%",
          height: "100%",
          display: "flex",
          flexDirection: "column",
          justifyContent: "center",
          padding: "80px",
          background: `linear-gradient(135deg, ${colors.gradientFrom} 0%, ${colors.gradientTo} 100%)`,
          fontFamily: "sans-serif",
        }}
      >
        {/* Brand mark */}
        <div style={{ display: "flex", alignItems: "center", gap: "16px", marginBottom: "32px" }}>
          <div
            style={{
              display: "flex",
              alignItems: "center",
              justifyContent: "center",
              width: "72px",
              height: "72px",
              borderRadius: "9999px",
              background: colors.brandPrimary,
              color: colors.markText,
              fontSize: "40px",
            }}
          >
            {brand.emoji}
          </div>
          <div style={{ display: "flex", flexDirection: "column" }}>
            <span style={{ fontSize: "40px", fontWeight: 700, color: colors.brandPrimary, lineHeight: 1.1 }}>
              {brand.primaryText}
            </span>
            <span style={{ fontSize: "18px", fontWeight: 600, letterSpacing: "4px", color: colors.brandSecondary }}>
              {brand.secondaryText}
            </span>
          </div>
        </div>

        {d.featureEmoji ? (
          <div style={{ display: "flex", fontSize: "72px", marginBottom: "16px" }}>
            {d.featureEmoji}
          </div>
        ) : null}

        {/* Headline */}
        <div
          style={{
            display: "flex",
            fontSize: "60px",
            fontWeight: 700,
            color: colors.headline,
            lineHeight: 1.1,
            marginBottom: "24px",
          }}
        >
          {d.headline}
        </div>

        {/* Subhead */}
        {d.subhead ? (
          <div style={{ display: "flex", fontSize: "30px", color: colors.subhead, lineHeight: 1.3, maxWidth: "900px" }}>
            {d.subhead}
          </div>
        ) : null}

        {/* Footer chips */}
        {d.chips.length > 0 ? (
          <div style={{ display: "flex", gap: "16px", marginTop: "44px" }}>
            {d.chips.map((t) => (
              <div
                key={t}
                style={{
                  display: "flex",
                  fontSize: "22px",
                  color: colors.chipText,
                  background: colors.chipBg,
                  border: `1px solid ${colors.chipBorder}`,
                  borderRadius: "9999px",
                  padding: "10px 22px",
                }}
              >
                {t}
              </div>
            ))}
          </div>
        ) : null}
      </div>
    ),
    { width: d.size.width, height: d.size.height },
  );
}
