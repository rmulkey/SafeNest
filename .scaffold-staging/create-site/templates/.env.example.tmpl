# __SITE_NAME__ — environment variables.
# Copy to .env.local for local dev. NEVER commit real secrets.

# --- Sanity (CMS) -----------------------------------------------------------
# Public read client (browser-safe). The dataset is per-site (Req 5.3).
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=production
# Server-only write token (publisher, blog generator, webhook score patching).
SANITY_API_TOKEN=
# Shared secret Sanity signs webhook payloads with (HMAC verification).
SANITY_WEBHOOK_SECRET=

# --- Database (shared Neon/Postgres, siteId-scoped) -------------------------
# The engine's @core/db layer reads this. Used by dashboards, click recording,
# newsletter storage, and the link-health cron.
DATABASE_URL=

# --- Cron auth --------------------------------------------------------------
# Vercel cron requests must send `Authorization: Bearer ${CRON_SECRET}`.
CRON_SECRET=

# --- SEO / site URL ---------------------------------------------------------
# Overrides the canonical base URL (otherwise derived from VERCEL_* or config).
NEXT_PUBLIC_SITE_URL=
# Optional Google Search Console verification token.
GOOGLE_SITE_VERIFICATION=

# --- Admin notifications (optional) -----------------------------------------
# Webhook the link-health cron posts unhealthy-link alerts to.
ADMIN_WEBHOOK_URL=

# --- Analytics (optional; consent-gated) ------------------------------------
NEXT_PUBLIC_GA4_MEASUREMENT_ID=
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_META_PIXEL_ID=
