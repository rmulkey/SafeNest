# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
# ...except the template, which is the only record of what a working
# environment needs. It carries variable names and non-secret defaults only;
# every credential in it is empty and DATABASE_URL points at localhost.
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# clerk configuration (can include secrets)
/.clerk/

# ASIN lookup worksheet (working file, filled in by hand)
scripts/asin-candidates.json

# Local backups written before destructive CMS operations
backups/

# Semrush exports (account + traffic data).
# `semrush/*` not `semrush/`: excluding the directory itself means a negation
# inside it can never apply, so `!semrush/README.md` silently did nothing.
semrush/*
!semrush/README.md

# Browser profile for vendor dashboards that have no write API. Holds live
# session cookies for Semrush and Google — must never be committed.
.playwright-profile/

# Search Console exports (first-party traffic data) and the service-account key.
# `gsc/*` not `gsc/`, for the same reason as semrush above.
gsc/*
!gsc/README.md
